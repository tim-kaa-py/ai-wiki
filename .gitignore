# Intermediate subtitle files
*.srt
*.ttml
*.vtt

# Python bytecode cache
__pycache__/
*.pyc

# Obsidian local config
.obsidian/

# Claude Code local settings
.claude/settings.local.json

# Author-private modules (see docs/private-modules.md)
linkedin/

# Local secrets — never commit
.env

# Reports written by the global tech-brief / storm-research skills and the daily-ai-briefing skill: keep them out of the public repo
tech-briefs/
storm-reports/
ai-research/

# Type declarations Claude Code writes into a mod it hot-reloads
.claude/skills/mod-*/.claude-plugin/types/

# User-level findings from claude-config-refresh runs: personal config, not for this public repo
.claude/restructure/*-user-level.md
